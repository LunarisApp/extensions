{
  "name": "@lunarisapp/exporter",
  "version": "0.0.1",
  "description": "Lunaris Exporter extension and integration contract",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "files": ["package-dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "bun run build:sdk && bunx --bun vite build",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "prepack": "bun run build:sdk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lunarisapp/plugin-sdk": "^0.9.0"
  },
  "devDependencies": {
    "@fontsource/unifont": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "types": "./package-dist/contract.d.ts",
      "import": "./package-dist/contract.js"
    }
  }
}
