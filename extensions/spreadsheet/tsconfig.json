{
	"compilerOptions": {
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"lib": ["DOM", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022"
	},
	"include": ["src", "vite.config.ts", "vitest.config.ts"]
}
