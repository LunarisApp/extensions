{
  "name": "@lunarisapp/create-extension",
  "version": "0.4.1",
  "description": "Create a Lunaris extension",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunarisApp/extensions.git",
    "directory": "create-extension"
  },
  "bin": {
    "create-extension": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js && bun scripts/copy-template.ts && chmod +x dist/index.js",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
